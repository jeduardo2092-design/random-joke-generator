# Server Configuration
PORT=3000
NODE_ENV=development

# Cache Configuration
CACHE_TTL=3600000
MAX_CACHE_SIZE=100
CACHE_ENABLED=true

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=1000
RETRY_BACKOFF_MULTIPLIER=2

# API Configuration
API_TIMEOUT=5000
JOKE_API_KEY=
OFFICIAL_JOKE_API_KEY=

# Logging
LOG_LEVEL=info
